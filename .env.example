# Public hostname that points to this DERPer server.
DERP_HOSTNAME=derp.example.com

# Published image. Replace this with your GHCR or Alibaba Cloud ACR image.
DERPER_IMAGE=ghcr.io/your-github-name/derper-docker:latest

# Container timezone.
TZ=Asia/Shanghai

# DERPer options.
# Defaults match install.sh: manual certificates (e.g. when 80/443 are already
# used by nginx) with HTTP disabled and HTTPS on 4443.
DERP_CERT_MODE=manual
DERP_CERT_DIR=/var/lib/derper/certs
DERP_CERT_FULLCHAIN=/etc/letsencrypt/live/derp.example.com/fullchain.pem
DERP_CERT_PRIVKEY=/etc/letsencrypt/live/derp.example.com/privkey.pem
DERP_HTTP_PORT=-1
DERP_HTTPS_PORT=4443
DERP_STUN_PORT=3478

# Set to true only after the host has tailscaled running and the socket is
# mounted with docker-compose.verify-clients.yml.
DERP_VERIFY_CLIENTS=false